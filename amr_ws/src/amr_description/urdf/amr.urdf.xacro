<?xml version="1.0"?>
<robot name="amr_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================= -->
  <!--      INPUT PARAMETERS   -->
  <!-- ======================= -->
  <!-- default values (can be overridden from robot_params.yaml) -->
  <xacro:property name="base_length" value="0.60"/>
  <xacro:property name="base_width"  value="0.45"/>
  <xacro:property name="base_height" value="0.08"/>

  <xacro:property name="wheel_radius"     value="0.065"/>
  <xacro:property name="wheel_width"      value="0.03"/>
  <xacro:property name="wheel_separation" value="0.3118"/>

  <xacro:property name="laser_x" value="0.22"/>
  <xacro:property name="laser_y" value="0.165"/>
  <xacro:property name="laser_z" value="0.165"/>

  <!-- ======================= -->
  <!--         BASE LINK       -->
  <!-- ======================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- ======================= -->
  <!--        WHEELS           -->
  <!-- ======================= -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>

  <!-- Wheel joints -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${wheel_separation/2} ${wheel_radius}" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -${wheel_separation/2} ${wheel_radius}" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ======================= -->
  <!--          LIDAR          -->
  <!-- ======================= -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <origin xyz="0 0 0.015"/>
      <material name="blue">
        <color rgba="0.2 0.5 1.0 1"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 3.14159"/>
  </joint>

</robot>
