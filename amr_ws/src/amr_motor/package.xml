<?xml version="1.0"?>
<package format="3">
  <name>amr_motor</name>
  <version>0.1.0</version>
  <description>Industrial AMR motor driver with Modbus RTU</description>

  <maintainer email="rodik.w.i@ftmm.unair.ac.id">amr</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>amr_user_interface</exec_depend>

  <exec_depend>python3-pymodbus</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
